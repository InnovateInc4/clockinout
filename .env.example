PORT=5000
JWT_SECRET=replace_with_a_long_random_secret

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=municipal_db

# Optional private development geofence. Leave blank to disable.
DEV_GEOFENCE_LAT=
DEV_GEOFENCE_LNG=

# External trusted-time verification.
# MySQL/server time remains the stored attendance authority; NTP is used to
# detect clock drift and provide a trusted reference for offline capture.
NTP_SERVER=time.google.com
NTP_TIMEOUT_MS=2000
NTP_REFRESH_MINUTES=15

# Offline attendance integrity limits.
OFFLINE_SYNC_MAX_AGE_HOURS=168
OFFLINE_MAX_GPS_ACCURACY_METERS=100
